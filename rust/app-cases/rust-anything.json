      "body"
    ],
    "input-007-get-metrics": [
      "body"
    ],
    "input-011-post-metrics": [
      "body"
    ]
  },
  "recorded": [
    "input-001-get-metrics",
    "input-002-get-metrics",
    "input-003-get-metrics",
    "input-004-get-metrics",
    "input-005-get-metrics",
    "input-006-get-metrics",
    "input-007-get-metrics",
    "input-008-get-metrics",
    "input-009-get-metrics",
    "input-010-head-metrics",
    "input-011-post-metrics",
    "input-012-get-healthz",
    "input-013-get-livez",
    "input-014-get-root",
    "input-015-get-nonexistent",
    "input-016-get-debug"
  ]
